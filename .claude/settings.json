{
  "permissions": {
    "deny": [
      "Read(//Volumes/<private-volume>/**)",
      "Edit(//Volumes/<private-volume>/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(ssh *)",
      "Bash(ssh-add *)",
      "Bash(ssh-keygen *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["/Volumes/<private-volume>", "~/.ssh"],
      "denyWrite": ["/Volumes/<private-volume>", "~/.ssh"]
    }
  }
}
